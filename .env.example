# Set to your verified public domain before deployment.
SITE_URL=http://localhost:3000
# Must point to persistent storage on a single Node server.
LEADS_DB_PATH=./data/leads.sqlite
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Live Metr Fit demo. Leave unset to show the illustrative demo instead.
# Use a store-scoped key with catalog and fit scopes; it stays server-side.
METR_API_URL=
METR_STORE_ID=
METR_API_KEY=
